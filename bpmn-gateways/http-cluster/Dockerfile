# Используем легковесный образ Node.js на базе Alpine Linux
FROM node:20-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /usr/src/app

# Копируем файлы манифестов зависимостей
COPY package*.json ./

# Устанавливаем только production-зависимости для уменьшения веса образа
RUN npm install --omit=dev

# Копируем исходный код микросервиса
COPY index.js ./

# Переключаемся на встроенного непривилегированного пользователя node для безопасности
USER node

# Открываем порт 8080, как указано в манифесте развертывания
EXPOSE 8080

# Команда запуска HTTP API Gateway
CMD ["node", "index.js"]